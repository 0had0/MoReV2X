#!/usr/bin/env bash
# Conventional Commits, as required by the git-workflow skill.
set -euo pipefail
first_line="$(head -1 "$1")"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .+'
if ! [[ "$first_line" =~ $pattern ]]; then
  echo "commit-msg: expected '<type>[scope]: <description>', got: $first_line" >&2
  exit 1
fi
if [ "${#first_line}" -gt 72 ]; then
  echo "commit-msg: subject is longer than 72 characters" >&2
  exit 1
fi

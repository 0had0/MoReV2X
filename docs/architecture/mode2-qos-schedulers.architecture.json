  "cards": [
    {
      "dot": "cyan",
      "title": "QoS flows",
      "items": [
        "Each flow tags its packets with SL priority (PPPP), PDB and RRI; the RLC copies the tag into the buffer report.",
        "A UE can carry a second flow (--ExtraFlow), with its own destination, so its own MAC process.",
        "Flows are served in priority order every slot: the most important one transmits first when two want the same slot."
      ]
    },
    {
      "dot": "emerald",
      "title": "SB-SPS and DS",
      "items": [
        "Same sensing selection; they differ in the reselection counter: Cresel drawn for the RRI (SPS) or 1 (DS).",
        "Chosen per UE: --Dynamic, or sps / dynamic in --SchedulerMap, with Pkeep, re-evaluation and pre-emption.",
        "Pre-emption compares the SCI priority of a reservation with the packet's own."
      ]
    },
    {
      "dot": "violet",
      "title": "RCS",
      "items": [
        "Replaces the sensing selection for the whole UE (--Rcs); no reservation, no sensing history used.",
        "The UE draws its group and tones from its NrV2XRcsChoice, which sees the packet's priority, PDB and age.",
        "Serves one flow per UE: --Rcs with --ExtraFlow is refused."
      ]
    }
  ]

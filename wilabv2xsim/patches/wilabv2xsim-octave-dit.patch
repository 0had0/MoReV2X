+        [simParams,varargin]= addNewParam(simParams,'DIT',false,'Double Initial Transmission at each SPS reselection','bool',fileCfg,varargin{1});
+        if simParams.DIT == true && simParams.mode5G ~=1
+            error('Error: "simParams.mode5G" must be equal to: 5G-V2X when DIT is active');
+        end
+
+        % [DITpreemption]
+        % With DIT, pre-emption check of the second resource T3 before it is used:
+        % the first transmission announces the second resource with a high priority,
+        % so a UE whose second resource is announced by another first transmission
+        % (and is no longer in Sa) selects another one
+        [simParams,varargin]= addNewParam(simParams,'DITpreemption',false,'Pre-emption check of the DIT second resource','bool',fileCfg,varargin{1});
+        if simParams.DITpreemption == true && simParams.DIT == false
+            error('Error: "simParams.DITpreemption" needs DIT');
+        end
+
         % [dynamicScheduling]
         % Enables the dynamic scheduling: resources are changed at each generation
         [simParams,varargin]= addNewParam(simParams,'dynamicScheduling',false,'Probability to keep the previously selected BR','bool',fileCfg,varargin{1});

# MoReV2X environment. Source it from the repository root: `source .env`
# It only changes this shell. `morev2x_env_off` restores what it replaced.

if [ -n "${BASH_SOURCE:-}" ]; then
  _morev2x_env_file="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION:-}" ]; then
  _morev2x_env_file="${(%):-%x}"
else
  _morev2x_env_file=".env"
fi
export MOREV2X_ROOT="$(cd "$(dirname "$_morev2x_env_file")" && pwd)"
unset _morev2x_env_file

if [ -z "${MOREV2X_ENV_ACTIVE:-}" ]; then
  export MOREV2X_SAVED_PATH="$PATH"
  export MOREV2X_SAVED_SUMO_HOME="${SUMO_HOME:-}"
  export MOREV2X_SAVED_PYTHONPATH="${PYTHONPATH:-}"
  export MOREV2X_SAVED_DYLD_LIBRARY_PATH="${DYLD_LIBRARY_PATH:-}"
  export MOREV2X_SAVED_PYENV_VERSION="${PYENV_VERSION:-}"
fi
export MOREV2X_ENV_ACTIVE=1

export MOREV2X_VENV="$MOREV2X_ROOT/.venv"
export SUMO_HOME="$MOREV2X_VENV/lib/python3.11/site-packages/sumo"
export PATH="$MOREV2X_VENV/bin:$SUMO_HOME/bin:$MOREV2X_ROOT/tools:$MOREV2X_SAVED_PATH"
unset PYTHONPATH PYENV_VERSION

export CC=/usr/bin/clang
export CXX=/usr/bin/clang++
export CXXFLAGS="-std=gnu++11 -O2 -g -ffp-contract=off -Wno-error -w"
export MOREV2X_BUILD="$MOREV2X_ROOT/build"
export MOREV2X_JOBS="${MOREV2X_JOBS:-8}"
export DYLD_LIBRARY_PATH="$MOREV2X_BUILD/lib"

morev2x_env_off () {
  export PATH="$MOREV2X_SAVED_PATH"
  if [ -n "$MOREV2X_SAVED_SUMO_HOME" ]; then export SUMO_HOME="$MOREV2X_SAVED_SUMO_HOME"; else unset SUMO_HOME; fi
  if [ -n "$MOREV2X_SAVED_PYTHONPATH" ]; then export PYTHONPATH="$MOREV2X_SAVED_PYTHONPATH"; fi
  if [ -n "$MOREV2X_SAVED_DYLD_LIBRARY_PATH" ]; then export DYLD_LIBRARY_PATH="$MOREV2X_SAVED_DYLD_LIBRARY_PATH"; else unset DYLD_LIBRARY_PATH; fi
  if [ -n "$MOREV2X_SAVED_PYENV_VERSION" ]; then export PYENV_VERSION="$MOREV2X_SAVED_PYENV_VERSION"; fi
  unset CC CXX CXXFLAGS MOREV2X_ENV_ACTIVE MOREV2X_ROOT MOREV2X_VENV MOREV2X_BUILD MOREV2X_JOBS
  unset MOREV2X_SAVED_PATH MOREV2X_SAVED_SUMO_HOME MOREV2X_SAVED_PYTHONPATH MOREV2X_SAVED_DYLD_LIBRARY_PATH MOREV2X_SAVED_PYENV_VERSION
  unset -f morev2x_env_off
}

if [ ! -x "$MOREV2X_VENV/bin/python" ]; then
  echo "MoReV2X: .venv is missing, run tools/bootstrap.sh" >&2
fi
